# see https://github.com/itsmng/helm-charts/blob/master/charts/itsmng/values.yaml

itsmweb:

  podSecurityContext:
    fsGroup: 33
    fsGroupChangePolicy: "Always"

  containerSecurityContext:
    allowPrivilegeEscalation: false
    privileged: false
    runAsNonRoot: true
    runAsUser: 33
    runAsGroup: 33
    readOnlyRootFilesystem: false
    capabilities:
      drop:
        - "ALL"
    seccompProfile:
      type: "RuntimeDefault"

  image:
    repository: docker.io/mdimonte/itsm-ng
    tag: latest

  ports:
  - port: 80
    protocol: TCP
    targetPort: 8080
  type: ClusterIP

  ingress:
    hostname: "itsm-ng-preprod.dev.opicloud.fr"
  
  pvc:
    storageClassName: "bsu-gp2"

  database:
    # To use internal mariadb cluster use <release name>-mariadb-galera
    hostname: "{{ .Release.Name }}-mariadb-galera"
    user:
      username: "itsmng"
      # 'password' is set in secrets.enc.yaml
    dbname: "itsmng"
  
  cronjob:
    image:
      repository: docker.io/mdimonte/itsm-ng
      tag: latest-cron
    resources:
      requests:
        cpu: 100m
        memory: 32Mi
      limits:
        memory: 128Mi

mariadb-galera:
  enabled: true

  image:
    registry: docker.io
    repository: bitnamilegacy/mariadb-galera
    tag: 12.0.2-debian-12-r0
  
  db:
    name: "itsmng"
    user: "itsmng"
    # 'password' is set in secrets.enc.yaml

  metrics:
    image:
      registry: docker.io
      repository: bitnamilegacy/mysqld-exporter

  global:
    defaultStorageClass: "bsu-gp2"
