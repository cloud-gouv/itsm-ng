environments:
  {{ .Environment.Name }}:
    values: []

---
releases:
  - name: its-ppr
    namespace: its-ppr
    chart: oci://ghcr.io/cloud-gouv/common-helm-charts/itsm-ng
    version: 0.1.0
    installed: true
    createNamespace: false
    values:
      - environments/{{ .Environment.Name }}/values.yaml.gotmpl
    secrets:
      - environments/{{ .Environment.Name }}/secrets.enc.yaml